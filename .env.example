# Local Docker default. For Neon, use the pooled connection string with ?sslmode=require.
DATABASE_URL=postgres://corvo:corvo@localhost:5433/corvo
AUTH_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:3000
# Local-only: point at the supplied task kit. It is not committed.
KIT_DIR=../Cantill_FullStack_Task_Kit
LLM_MODEL=gpt-6.1-terra
# Optional. Without it, chat uses the deterministic guided fallback.
# OPENAI_API_KEY=
